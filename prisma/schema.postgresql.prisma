datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                            String    @id @default(uuid())
  name                          String
  email                         String    @unique
  password                      String
  phone                         String?
  city                          String?   @default("Berlin")
  plz                           String?   @default("10115")
  avatar                        String?
  accountType                   String    @default("Privat")
  bio                           String?
  role                          String    @default("USER")
  status                        String    @default("ACTIVE")
  emailVerified                 Boolean   @default(false)
  emailVerificationToken        String?   @unique
  emailVerificationTokenExpires DateTime?
  resetToken                    String?   @unique
  resetTokenExpires             DateTime?
  twoFactorEnabled              Boolean   @default(false)
  twoFactorSecret               String?
  twoFactorRecoveryCodes        String?
  createdAt                     DateTime  @default(now())

  listings                      Listing[]
  favorites                     Favorite[]
  conversationsAsBuyer          Conversation[] @relation("BuyerConversations")
  conversationsAsSeller         Conversation[] @relation("SellerConversations")
  sentMessages                  Message[]
  notifications                 Notification[]

  savedSearches                 SavedSearch[]
  following                     Follow[]       @relation("UserFollowing")
  followers                     Follow[]       @relation("UserFollowers")
  offersSent                    Offer[]        @relation("SentOffers")
  offersReceived                Offer[]        @relation("ReceivedOffers")
  transactionsAsBuyer           Transaction[]  @relation("BuyerTransactions")
  transactionsAsSeller          Transaction[]  @relation("SellerTransactions")
  reviewsGiven                  Review[]       @relation("AuthorReviews")
  reviewsReceived               Review[]       @relation("TargetReviews")
  reportsSubmitted              Report[]       @relation("ReporterReports")
  reportsReceived               Report[]       @relation("ReportedUserReports")
  blocksInitiated               Block[]        @relation("BlockInitiator")
  blocksReceived                Block[]        @relation("BlockedTarget")
  moderationActions             ModerationAction[] @relation("ModeratorActions")
  moderationAppeals             ModerationAppeal[]
  securityEvents                SecurityEvent[]
  userSessions                  UserSession[]
  notificationPreference        NotificationPreference?

  @@index([email])
  @@index([role])
  @@index([status])
}

model Listing {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  categorySlug    String
  categoryNameDe  String
  categoryNameEn  String
  subcategory     String?
  price           Float
  priceType       String    @default("negotiable")
  locationCity    String
  locationPlz     String
  distanceKm      Int       @default(5)
  postedDate      String    @default("Heute")
  condition       String    @default("Wie neu")
  deliveryOptions String?
  status          String    @default("ACTIVE")
  descriptionDe   String
  descriptionEn   String
  images          String
  hasVideo        Boolean   @default(false)
  videoUrl        String?
  createdAt       DateTime  @default(now())

  favorites       Favorite[]
  conversations   Conversation[]
  offers          Offer[]
  transactions    Transaction[]
  views           ListingView[]

  @@index([userId])
  @@index([status])
  @@index([categorySlug])
  @@index([price])
  @@index([createdAt])
  @@index([locationCity])
  @@index([locationPlz])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Conversation {
  id        String   @id @default(uuid())
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyerId   String
  buyer     User     @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  offers    Offer[]

  @@unique([buyerId, sellerId, listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([isRead])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  type      String   @default("SYSTEM")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model SavedSearch {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  query           String?
  categorySlug    String?
  subcategory     String?
  minPrice        Float?
  maxPrice        Float?
  priceType       String?
  condition       String?
  locationCity    String?
  locationPlz     String?
  radiusKm        Int?     @default(10)
  sellerType      String?  @default("all")
  deliveryOnly    Boolean  @default(false)
  alertsEnabled   Boolean  @default(true)
  alertFrequency  String   @default("IMMEDIATE")
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([alertsEnabled])
  @@index([categorySlug])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Offer {
  id             String        @id @default(uuid())
  listingId      String
  listing        Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  buyerId        String
  buyer          User          @relation("SentOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User          @relation("ReceivedOffers", fields: [sellerId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String        @default("EUR")
  status         String        @default("PENDING")
  counterAmount  Float?
  counterNote    String?
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transaction    Transaction?

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([conversationId])
}

model Transaction {
  id               String    @id @default(uuid())
  listingId        String
  listing          Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId          String
  buyer            User      @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User      @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Cascade)
  offerId          String?   @unique
  offer            Offer?    @relation(fields: [offerId], references: [id], onDelete: SetNull)
  agreedPrice      Float
  status           String    @default("AGREED")
  handoverCodeHash String?
  buyerConfirmed   Boolean   @default(false)
  sellerConfirmed  Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reviews          Review[]

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model Review {
  id                   String      @id @default(uuid())
  transactionId        String
  transaction          Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  authorId             String
  author               User        @relation("AuthorReviews", fields: [authorId], references: [id], onDelete: Cascade)
  targetId             String
  target               User        @relation("TargetReviews", fields: [targetId], references: [id], onDelete: Cascade)
  role                 String
  ratingOverall        Int
  ratingCommunication  Int?
  ratingReliability    Int?
  ratingDescription    Int?
  ratingFriendliness   Int?
  comment              String?
  status               String      @default("ACTIVE")
  createdAt            DateTime    @default(now())

  @@unique([transactionId, authorId])
  @@index([targetId])
  @@index([authorId])
  @@index([status])
}

model Report {
  id              String    @id @default(uuid())
  reporterId      String
  reporter        User      @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType      String
  targetId        String
  reportedUserId  String?
  reportedUser    User?     @relation("ReportedUserReports", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reason          String
  description     String
  status          String    @default("PENDING")
  moderationNote  String?
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime  @default(now())

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([targetType])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockInitiator", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model ModerationAction {
  id            String   @id @default(uuid())
  moderatorId   String
  moderator     User     @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)
  actionType    String
  targetType    String
  targetId      String
  reason        String
  previousState String?
  newState      String?
  createdAt     DateTime @default(now())

  @@index([moderatorId])
  @@index([targetId])
  @@index([actionType])
}

model ModerationAppeal {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionId          String?
  targetType        String
  targetId          String
  reason            String
  status            String    @default("SUBMITTED")
  moderatorResponse String?
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  @@index([userId])
  @@index([status])
}

model ListingView {
  id           String   @id @default(uuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewerIpHash String?
  createdAt    DateTime @default(now())

  @@index([listingId])
  @@index([createdAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  deviceInfo   String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailMessages      Boolean  @default(true)
  emailOffers        Boolean  @default(true)
  emailSavedSearches Boolean  @default(true)
  emailFollowers     Boolean  @default(true)
  emailTransactions  Boolean  @default(true)
  emailMarketing     Boolean  @default(false)
  inAppMessages      Boolean  @default(true)
  inAppOffers        Boolean  @default(true)
  inAppSavedSearches Boolean  @default(true)
  inAppFollowers     Boolean  @default(true)
  inAppTransactions  Boolean  @default(true)
}
