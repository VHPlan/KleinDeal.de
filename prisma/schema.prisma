datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                            String    @id @default(uuid())
  name                          String
  email                         String    @unique
  password                      String
  phone                         String?
  city                          String?   @default("Berlin")
  plz                           String?   @default("10115")
  avatar                        String?
  accountType                   String    @default("Privat") // Privat or Gewerblich
  bio                           String?
  role                          String    @default("USER") // USER, MODERATOR, ADMIN
  status                        String    @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED
  emailVerified                 Boolean   @default(false)
  emailVerificationToken        String?
  emailVerificationTokenExpires DateTime?
  resetToken                    String?
  resetTokenExpires             DateTime?
  twoFactorEnabled              Boolean   @default(false)
  twoFactorSecret               String?
  twoFactorRecoveryCodes        String?
  createdAt                     DateTime  @default(now())

  listings                      Listing[]
  favorites                     Favorite[]
  conversationsAsBuyer          Conversation[] @relation("BuyerConversations")
  conversationsAsSeller         Conversation[] @relation("SellerConversations")
  sentMessages                  Message[]
  notifications                 Notification[]

  // High-value marketplace relationships
  savedSearches                 SavedSearch[]
  following                     Follow[]       @relation("UserFollowing")
  followers                     Follow[]       @relation("UserFollowers")
  offersSent                    Offer[]        @relation("SentOffers")
  offersReceived                Offer[]        @relation("ReceivedOffers")
  transactionsAsBuyer           Transaction[]  @relation("BuyerTransactions")
  transactionsAsSeller          Transaction[]  @relation("SellerTransactions")
  reviewsGiven                  Review[]       @relation("AuthorReviews")
  reviewsReceived               Review[]       @relation("TargetReviews")
  reportsSubmitted              Report[]       @relation("ReporterReports")
  reportsReceived               Report[]       @relation("ReportedUserReports")
  blocksInitiated               Block[]        @relation("BlockInitiator")
  blocksReceived                Block[]        @relation("BlockedTarget")
  moderationActions             ModerationAction[] @relation("ModeratorActions")
  moderationAppeals             ModerationAppeal[]
  securityEvents                SecurityEvent[]
  userSessions                  UserSession[]
  notificationPreference        NotificationPreference?
}

model Listing {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  categorySlug    String
  categoryNameDe  String
  categoryNameEn  String
  subcategory     String?
  price           Float
  priceType       String    @default("negotiable") // fixed, negotiable, free, monthly, hourly
  locationCity    String
  locationPlz     String
  distanceKm      Int       @default(5)
  postedDate      String    @default("Heute")
  condition       String    @default("Wie neu")
  deliveryOptions String?
  status          String    @default("ACTIVE") // ACTIVE, DRAFT, RESERVED, SOLD, DEACTIVATED, REMOVED
  descriptionDe   String
  descriptionEn   String
  images          String    // JSON stringified array of image URLs
  hasVideo        Boolean   @default(false)
  videoUrl        String?
  createdAt       DateTime  @default(now())

  favorites       Favorite[]
  conversations   Conversation[]
  offers          Offer[]
  transactions    Transaction[]
  views           ListingView[]
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Conversation {
  id        String   @id @default(uuid())
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyerId   String
  buyer     User     @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  offers    Offer[]

  @@unique([buyerId, sellerId, listingId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  type      String   @default("SYSTEM") // SYSTEM, MESSAGE, OFFER, SEARCH_ALERT, FOLLOW_ALERT, TRANSACTION, REVIEW, SECURITY
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// 1. SAVED SEARCHES (SUCHAUFTRÄGE)
// ----------------------------------------------------------------------------
model SavedSearch {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  query           String?
  categorySlug    String?
  subcategory     String?
  minPrice        Float?
  maxPrice        Float?
  priceType       String?
  condition       String?
  locationCity    String?
  locationPlz     String?
  radiusKm        Int?     @default(10)
  sellerType      String?  @default("all") // 'Privat' | 'Gewerblich' | 'all'
  deliveryOnly    Boolean  @default(false)
  alertsEnabled   Boolean  @default(true)
  alertFrequency  String   @default("IMMEDIATE") // IMMEDIATE, DAILY, OFF
  createdAt       DateTime @default(now())
}

// ----------------------------------------------------------------------------
// 2. SELLER FOLLOWING (NUTZER FOLGEN)
// ----------------------------------------------------------------------------
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

// ----------------------------------------------------------------------------
// 3. STRUCTURED OFFERS (PREISANGEBOTE)
// ----------------------------------------------------------------------------
model Offer {
  id             String        @id @default(uuid())
  listingId      String
  listing        Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  buyerId        String
  buyer          User          @relation("SentOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User          @relation("ReceivedOffers", fields: [sellerId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String        @default("EUR")
  status         String        @default("PENDING") // PENDING, COUNTERED, ACCEPTED, REJECTED, WITHDRAWN, EXPIRED, CANCELLED
  counterAmount  Float?
  counterNote    String?
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transaction    Transaction?
}

// ----------------------------------------------------------------------------
// 4. TRANSACTIONS & HANDOVER CODES
// ----------------------------------------------------------------------------
model Transaction {
  id               String    @id @default(uuid())
  listingId        String
  listing          Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId          String
  buyer            User      @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User      @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Cascade)
  offerId          String?   @unique
  offer            Offer?    @relation(fields: [offerId], references: [id], onDelete: SetNull)
  agreedPrice      Float
  status           String    @default("AGREED") // AGREED, RESERVED, HANDOVER_PENDING, COMPLETED, CANCELLED, DISPUTED
  handoverCodeHash String?
  buyerConfirmed   Boolean   @default(false)
  sellerConfirmed  Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reviews          Review[]
}

// ----------------------------------------------------------------------------
// 5. GENUINE REVIEWS (BEWERTUNGEN)
// ----------------------------------------------------------------------------
model Review {
  id                   String      @id @default(uuid())
  transactionId        String
  transaction          Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  authorId             String
  author               User        @relation("AuthorReviews", fields: [authorId], references: [id], onDelete: Cascade)
  targetId             String
  target               User        @relation("TargetReviews", fields: [targetId], references: [id], onDelete: Cascade)
  role                 String      // BUYER, SELLER
  ratingOverall        Int         // 1 to 5
  ratingCommunication  Int?
  ratingReliability    Int?
  ratingDescription    Int?
  ratingFriendliness   Int?
  comment              String?
  status               String      @default("ACTIVE") // ACTIVE, HIDDEN, REPORTED
  createdAt            DateTime    @default(now())

  @@unique([transactionId, authorId])
}

// ----------------------------------------------------------------------------
// 6. REPORTING SYSTEM (MELDUNGEN)
// ----------------------------------------------------------------------------
model Report {
  id              String    @id @default(uuid())
  reporterId      String
  reporter        User      @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType      String    // LISTING, USER, MESSAGE, REVIEW
  targetId        String
  reportedUserId  String?
  reportedUser    User?     @relation("ReportedUserReports", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reason          String
  description     String
  status          String    @default("PENDING") // PENDING, UNDER_REVIEW, RESOLVED, DISMISSED
  moderationNote  String?
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime  @default(now())
}

// ----------------------------------------------------------------------------
// 7. USER BLOCKING (BLOCKIERUNGEN)
// ----------------------------------------------------------------------------
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockInitiator", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedTarget", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// ----------------------------------------------------------------------------
// 8. MODERATION ACTIONS & AUDIT LOG
// ----------------------------------------------------------------------------
model ModerationAction {
  id            String   @id @default(uuid())
  moderatorId   String
  moderator     User     @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)
  actionType    String   // WARN_USER, HIDE_LISTING, REMOVE_LISTING, HIDE_REVIEW, RESTRICT_MESSAGING, SUSPEND_USER, BAN_USER
  targetType    String   // USER, LISTING, REVIEW, REPORT
  targetId      String
  reason        String
  previousState String?
  newState      String?
  createdAt     DateTime @default(now())
}

// ----------------------------------------------------------------------------
// 9. MODERATION APPEALS (BESCHWERDEN / EINSPRÜCHE)
// ----------------------------------------------------------------------------
model ModerationAppeal {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionId          String?
  targetType        String
  targetId          String
  reason            String
  status            String    @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, ACCEPTED, REJECTED
  moderatorResponse String?
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
}

// ----------------------------------------------------------------------------
// 10. LISTING ANALYTICS (ANZEIGEN-STATISTIKEN)
// ----------------------------------------------------------------------------
model ListingView {
  id           String   @id @default(uuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewerIpHash String?
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------------
// 11. SECURITY EVENTS & AUDIT HISTORY
// ----------------------------------------------------------------------------
model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String   // LOGIN_SUCCESS, LOGIN_FAILED, PASSWORD_CHANGED, EMAIL_VERIFIED, TWO_FACTOR_ENABLED, SESSION_REVOKED
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// 12. USER SESSIONS (AKTIVE SITZUNGEN)
// ----------------------------------------------------------------------------
model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  deviceInfo   String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------------
// 13. NOTIFICATION PREFERENCES (BENACHRICHTIGUNGSEINSTELLUNGEN)
// ----------------------------------------------------------------------------
model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailMessages      Boolean  @default(true)
  emailOffers        Boolean  @default(true)
  emailSavedSearches Boolean  @default(true)
  emailFollowers     Boolean  @default(true)
  emailTransactions  Boolean  @default(true)
  emailMarketing     Boolean  @default(false)
  inAppMessages      Boolean  @default(true)
  inAppOffers        Boolean  @default(true)
  inAppSavedSearches Boolean  @default(true)
  inAppFollowers     Boolean  @default(true)
  inAppTransactions  Boolean  @default(true)
}
