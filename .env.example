# ==============================================================================
# KleinDeal.de - Production & Development Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, set these variables in your hosting environment (e.g. Vercel, Railway, Fly.io, AWS).
# NEVER commit real secret values to Git!
# ==============================================================================

# Application Environment & Base URL
NODE_ENV=production
APP_URL=https://kleindeal.de

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL for Production, SQLite for Local Dev)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (e.g. Supabase, Neon, AWS RDS, Railway Postgres)
DATABASE_URL="postgresql://username:password@db.example.com:5432/kleindeal?schema=public&sslmode=require"
# Direct URL for Prisma migrations when using connection poolers (e.g. PgBouncer)
DIRECT_DATABASE_URL="postgresql://username:password@db.example.com:5432/kleindeal?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 2. DISTRIBUTED RATE LIMITING (Redis)
# ------------------------------------------------------------------------------
# Redis connection URL (e.g. Upstash Redis, Redis Cloud, AWS ElastiCache)
REDIS_URL="redis://default:secret_token@redis.example.com:6379"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL (Resend or SMTP)
# ------------------------------------------------------------------------------
# Provider choice: 'resend' | 'smtp' | 'development_log'
EMAIL_PROVIDER=resend
EMAIL_FROM="KleinDeal.de <noreply@kleindeal.de>"

# Resend API Configuration (Recommended)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Alternative SMTP Configuration (e.g. Postmark, SendGrid, Amazon SES SMTP)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@kleindeal.de
SMTP_PASSWORD=smtp_secret_password
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (S3-compatible: Cloudflare R2, AWS S3, MinIO)
# ------------------------------------------------------------------------------
# Storage choice: 's3' | 'local'
STORAGE_PROVIDER=s3

# S3 Configuration
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=kleindeal-uploads
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_PUBLIC_URL=https://images.kleindeal.de

# ------------------------------------------------------------------------------
# 5. SECURITY & SESSIONS
# ------------------------------------------------------------------------------
# Cryptographically random 64-character hex string for signing session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=generate_a_secure_64_character_random_hex_secret_key_here

# ------------------------------------------------------------------------------
# 6. DEMO MODE & MONITORING
# ------------------------------------------------------------------------------
# Set to 'false' in production; 'true' enables in-memory showcase demo listings when DB is empty
NEXT_PUBLIC_DEMO_MODE=false

# Sentry DSN for error monitoring & performance tracing (Optional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
