# ==============================================================================
# KleinDeal.de - Staging Environment Configuration Template
# ==============================================================================

# Application Environment
APP_ENV=staging
NODE_ENV=production
APP_URL=https://staging.kleindeal.de

# Staging Database (PostgreSQL)
# Must connect to an isolated staging database (never use production DB!)
DATABASE_URL=postgresql://staging_user:staging_password@staging-db.example.com:5432/kleindeal_staging?sslmode=require
DIRECT_DATABASE_URL=postgresql://staging_user:staging_password@staging-db.example.com:5432/kleindeal_staging?sslmode=require

# Staging Object Storage (S3 / Cloudflare R2)
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=kleindeal-staging-uploads
S3_ACCESS_KEY_ID=your_staging_s3_access_key
S3_SECRET_ACCESS_KEY=your_staging_s3_secret_key
S3_PUBLIC_URL=https://staging-media.kleindeal.de
S3_KEY_PREFIX=staging/

# Staging Rate Limiting & Cache (Redis)
RATE_LIMIT_PROVIDER=redis
REDIS_URL=rediss://default:your_staging_redis_token@staging-redis.example.com:6379
REDIS_KEY_PREFIX=kleindeal:staging:

# Staging Transactional Email (Resend or SMTP)
EMAIL_PROVIDER=resend
EMAIL_FROM=KleinDeal Staging <noreply@staging.kleindeal.de>
RESEND_API_KEY=re_staging_your_api_key_here
# Alternative SMTP Configuration:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@staging.kleindeal.de
# SMTP_PASSWORD=your_staging_smtp_password
# SMTP_SECURE=false

# Staging Session Security
# Generate via: openssl rand -base64 48 (Minimum 32 characters, must differ from production)
SESSION_SECRET=your_staging_unique_high_entropy_session_secret_min32

# Staging Private Access Gate & Job Webhook Secrets
STAGING_ACCESS_PASSWORD=your_secure_staging_access_password
CRON_SECRET=your_staging_cron_job_secret_token

# Error Monitoring (Sentry)
MONITORING_ENABLED=true
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=staging

# Feature Flags (All disabled in staging)
NEXT_PUBLIC_DEMO_MODE=false
AI_LISTING_ASSISTANT_ENABLED=false
